# Rust
/target/
**/target/
**/*.rs.bk
*.pdb
# Cargo.lock IS committed at workspace root because we ship the
# yutha-control-plane binary; locking dep versions matters for
# reproducible builds. Library-only crates can decide otherwise locally.
*.profraw
*.profdata
rust-project.json
.rust-analyzer/
flamegraph.svg

# Cargo credentials (publish tokens etc.) — credentials.toml MUST NOT be
# checked in. config.toml at workspace root is fine to commit.
.cargo/credentials.toml
.cargo/credentials

# Go
*.test
*.out
coverage.html
coverage.txt
vendor/

# Python (for the forthcoming SDK)
**/__pycache__/
*.pyc
*.pyo
.venv/
venv/
.python-version
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment
.env
.env.local
.envrc
.direnv/

# Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db

# sqlx offline cache — we don't use compile-time-checked macros yet, and
# this directory gets regenerated when we do.
**/.sqlx/

# Local Postgres scratch (docker-compose volumes, pg_dump output, etc.)
pgdata/
*.dump

# Local-only
/tmp/
/scratch/
/.scratch/

# Build outputs
/dist/
/build/
*.tar.gz
*.zip
*.bak

# Sui sealer keys (suiprivkey1... bech32). Some `sui keytool` flows write
# these to cwd as `<address>.key`; they're private material and must not
# enter git. Same goes for the per-operator ~/.yutha/sealer.key staged by
# the H5 localnet walkthrough.
*.key

# Sui `sui client test-publish` ephemeral state (chain-id pinned to the
# last localnet regenesis). Regenerated on each --force-regenesis; not
# source of truth.
Pub.*.toml

# Server logs from local control-plane runs (tee-d during integration
# test debugging). Never useful in tree.
server.log
*.log

# Move-compiler output. `sui move build` / `sui client publish`
# regenerates this directory on every invocation; committing it
# produces enormous diffs and ties the repo to one Sui framework
# version. Keep `sources/`, `tests/`, and `Move.toml`; skip `build/`.
contracts/sui/**/build/

# MkDocs build output. `mkdocs build` regenerates this on every run;
# the deployed site lives on GitHub Pages, not in the repo.
/site/
