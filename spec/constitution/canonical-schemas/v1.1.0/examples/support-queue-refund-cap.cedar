// Generated by yutha-ops compile.
// Source description:      Customer-support refund cap — supervisors only for >$100
// Authored constitution_version: 1.0.0
// Schema version:          1.1.0

// Refunds over $100 require supervisor approval
@id("refund-cap-requires-supervisor")
forbid (
    principal,
    action == Yutha::SupportQueue::Action::"IssueRefund",
    resource
) when {
    context.refund_amount_cents > 10000 && principal.passport_tier != "verifiable"
};

// Block payloads tagged as known-forbidden
@id("no-forbidden-payloads")
forbid (
    principal,
    action == Yutha::Action::"SendEnvelope",
    resource
) when {
    context.payload_schema_id == "type.yutha.dev/v1/Forbidden"
};

// Trailing permit-all (closed_by_default: false). Everything the
// rules above don't forbid lands here and permits.
permit (principal, action, resource);
